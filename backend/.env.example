# AI 运维监控平台 —— 环境变量样例（复制为 backend/.env 后填值；.env 不入库）
# 说明：正式部署的 LLM 配置应在「系统设置页」填写并落库（api_key AES-GCM 加密存储），
#       下列 LLM_* 仅作为无 DB 配置时的兜底（demo/首次启动）。
DEBUG=false

# --- 数据库（SeekDB v1.4.0，MySQL 协议）---
DB_HOST=127.0.0.1
DB_PORT=2891
DB_USER=root
# 数据库密码：本机/内网试玩可留空；公网或多人使用必须填随机值（生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）
DB_PASSWORD=
# 数据库口令：建议**纯字母数字**（带 - _ 等符号时部分 SeekDB 版本解析异常）
# 升级已有部署时，必须与旧库口令一致，否则 seekdb 会因 Password.Incorrect 反复重启
# 宿主端口映射（可选，默认即可；改了要同时放行云安全组）
# PLATFORM_PORT=8848   # 平台对外端口（平台日志里打印的访问地址随之变化）
# DB_HOST_PORT=2891    # 数据库对外端口（平台走容器内 2881，不受影响）
DB_NAME=aiops

# --- 安全（生产必须替换为随机值；生成：python -c "import secrets;print(secrets.token_urlsafe(48))"）---
# 管理员初始密码（可选）：不设则用默认 admin123（与早期版本一致）
# 公网部署**强烈建议在这里设一个自己的口令**——开源包源码人人可见，
# 默认口令等于公开的初始凭据；本值仅首次创建管理员时生效
ADMIN_PASSWORD=
JWT_SECRET=change-me-in-env
KEY_STORE_SECRET=change-me-in-env

# --- LLM 兜底（OpenAI 兼容端点）---
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL_MAIN=MiniMax-M3
LLM_MODEL_FAST=MiniMax-M2.7-highspeed

# --- PowerContext 跨会话经验库（可选，试点 D233）---
# 独立部署 powercontext-server 后填写；留空 = 诊断 Agent 的经验召回/写入关闭
# POWERCONTEXT_BASE_URL=http://powercontext:8000
# POWERCONTEXT_SCOPE_ID=testops-ops

# ── 镜像源（出网受限时换，默认无需改）────────────────────────────
# daocloud 的后端在 Cloudflare，部分机房/云厂商网络直连不通（真机实测 connection refused）。
# 换成华为云镜像加速（实测可用）：
# BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/python:3.11-slim
# SEEKDB_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/oceanbase/seekdb:latest
