# D235：**不要写 `# syntax=docker/dockerfile:x.y`**——它会让构建额外去 registry 拉
# 一个 frontend 镜像；受限网络里这一步必挂（真机实测 connection refused）。
# Docker 20.10+ 内置的 BuildKit frontend 已支持 RUN --mount=type=cache，无需指定版本。
#
# D235 构建提速三板斧（开源部署实测「构建卡住十几分钟」）：
#   ① 重依赖移出主依赖（scikit-learn→numpy+scipy ≈ 90MB → requirements-ai.txt 可选）
#   ② BuildKit pip 缓存层：首次受镜像源带宽限制，之后重建**秒级**
#   ③ 离线 wheel 模式：deploy/wheels/ 有 wheel 时全程不联网（tools/build_platform_wheels.sh 生成）
# 换镜像源：--build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# （真机实测：connection refused，e2e 验收时才发现）。
# D235：基础镜像可配（出网受限时换华为云等可达源，见《自建部署加速指引》）
ARG BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="AI 运维监控平台"
LABEL org.opencontainers.image.description="告警引擎 + AI 诊断 + 处置闭环"

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

# 不装任何 apt 包（D227 用户实测：deb.debian.org 国内网络连不上导致构建失败）。
# curl 原本只给 HEALTHCHECK 用——python:slim 自带 ca-certificates（pip TLS 即依赖它），
# 健康检查改用镜像内现成的 python urllib，apt 依赖归零。
# 依赖先装（利用层缓存）。pip 源默认阿里云镜像（2026-10-21 固化：公网构建实测直连
# pypi.org 30+ 分钟、阿里云 ~10 分钟）；compose 层还会传 build.args，二选一生效。
# 临时换源：docker compose build --build-arg PIP_INDEX_URL=https://pypi.org/simple platform
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
COPY backend/requirements.txt /app/requirements.txt
COPY backend/requirements-ai.txt /app/requirements-ai.txt
# 离线 wheel 目录（可选）：tools/build_platform_wheels.sh 生成到 deploy/wheels/；
# 目录非空 → pip 全程 --no-index 不联网（内网/慢网构建救星）；为空 → 走镜像源。
COPY deploy/wheels/ /opt/wheels/
# BuildKit 缓存层：pip 的下载缓存跨构建复用（不再用 --no-cache-dir——它与缓存层互斥，
# 会让每次重建都重新下载几十 MB）。需要 BuildKit（Docker 23+ 默认开启）。
RUN --mount=type=cache,target=/root/.cache/pip \
    if ls /opt/wheels/*.whl >/dev/null 2>&1; then \
        echo "[build] 使用离线 wheel 目录 /opt/wheels（不联网）"; \
        pip install --no-index --find-links /opt/wheels -r requirements.txt; \
    else \
        echo "[build] 使用镜像源 ${PIP_INDEX_URL}"; \
        pip install -i ${PIP_INDEX_URL} -r requirements.txt; \
    fi
# 可选增强（孤立森林）：默认不装——安装会额外拉 numpy/scipy/sklearn ≈ 90MB。
# 需要时：docker compose build --build-arg INSTALL_AI_DEPS=true platform
ARG INSTALL_AI_DEPS=false
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "${INSTALL_AI_DEPS}" = "true" ]; then \
        echo "[build] 安装可选 AI 依赖（scikit-learn → 孤立森林算法可用）"; \
        if ls /opt/wheels/*.whl >/dev/null 2>&1; then \
            pip install --no-index --find-links /opt/wheels -r requirements-ai.txt; \
        else \
            pip install -i ${PIP_INDEX_URL} -r requirements-ai.txt; \
        fi; \
    else \
        echo "[build] 跳过可选 AI 依赖（孤立森林将自动降级为 3σ，容量预测不受影响）"; \
    fi

# 代码与静态资源
COPY backend /app
COPY static /static
COPY agent /agent-src
ENV STATIC_DIR=/static \
    AGENT_SRC_DIR=/agent-src

# ── D66 版本与内置手册 ──────────────────────────────────────────────
# 版本号单一来源：仓库根 VERSION（后端 app/core/version.py 读取并在 /api/health 暴露）
COPY VERSION /app/VERSION
# 构建号（可选注入）：docker compose build --build-arg GIT_SHA=$(git rev-parse --short HEAD)
ARG GIT_SHA=dev
ARG BUILD_TIME=
ENV GIT_SHA=${GIT_SHA} BUILD_TIME=${BUILD_TIME}

# 内置用户手册：源是 docs/ 下的**客户版**手册（单一来源，不提交副本进仓库；
# 内部版 用户手册.内部.md 不随包分发）。前端「文档 → 使用手册」页读取这些静态文件。
# D235：演示视频是**可选素材**——OSS 导出包不含视频（体积大 + 版权），此前这里硬 COPY
# 具体文件名 → 开源用户全新克隆构建必然报 "not found"（D235 用户实测踩到；本地仓库有缓存
# 才没暴露）。改为整目录 COPY + 脚本内挑文件：有则复制、没有就跳过并打印说明，
# **任何情况下构建都不再失败**（手册页在没有视频时提示到公众号看演示）。
RUN mkdir -p /static/manual/videos && \
    for pair in "videos/demo-latest/demo-v1.2.1_配音_字幕.mp4:demo.mp4" \
                "videos/demo-latest/demo-v1.2.1_en.mp4:demo-en.mp4" \
                "videos/demo-latest/demo-poster.jpg:demo-poster.jpg"; do \
      s="${pair%%:*}"; d="${pair##*:}"; \
      if [ -f "/tmp/manual-src/$s" ]; then cp "/tmp/manual-src/$s" "/static/manual/videos/$d"; \
      else echo "[manual] 缺少演示素材 $s（开源包不含视频，跳过）"; fi; \
    done
# 手册里的 `{{VERSION}}` 占位符要在**镜像内**落地：正文用占位符是为了让版本号单一来源
# （改一处即可），生成器给 Word/PDF 替换、sync_manual 给本地静态目录替换——但**镜像是从 docs/ 直接 COPY 的**，
# 前两处都管不到它（实测：容器里的手册一直显示"当前版本（{{VERSION}}）"）。
# 所以构建时再替换一次；三处出口同一套规则。
RUN python3 - <<'PYEOF_V'
import pathlib, re, hashlib
v = pathlib.Path("/app/VERSION").read_text(encoding="utf-8").strip()
for f in sorted(pathlib.Path("/static/manual").glob("*.md")):
    if f.name.startswith("._") or f.name == ".DS_Store":
        continue   # macOS 拷贝/压缩常混入 AppleDouble 垃圾（二进制），读了就 UnicodeDecodeError（靶机实测）
    t = f.read_text(encoding="utf-8")
    if "{{VERSION}}" in t:
        f.write_text(re.sub(r"\{\{VERSION\}\}", "v" + v, t), encoding="utf-8")
        print(f"[manual] {f.name} 版本占位符 → v{v}")
# 视频/海报 URL 追加内容指纹（缓存击穿，D94）：与 sync_manual.py 同一套规则——
# 镜像是手册的又一条出口，漏了这条用户就会继续播浏览器缓存的旧成片（实测踩到）。
vid = pathlib.Path("/static/manual/videos/demo.mp4")
if vid.exists():
    h = hashlib.md5(vid.read_bytes()).hexdigest()[:8]
    for f in sorted(pathlib.Path("/static/manual").glob("*.md")):
        if f.name.startswith("._") or f.name == ".DS_Store":
            continue
        t = f.read_text(encoding="utf-8")
        t2 = t.replace("videos/demo.mp4", f"videos/demo.mp4?v={h}").replace(
            "videos/demo-poster.jpg", f"videos/demo-poster.jpg?v={h}")
        if t2 != t:
            f.write_text(t2, encoding="utf-8")
            print(f"[manual] {f.name} 视频 URL 指纹 → ?v={h}")
PYEOF_V

EXPOSE 8848
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD ["python3", "-c", "import urllib.request,sys;urllib.request.urlopen('http://127.0.0.1:8848/api/health', timeout=3);sys.exit(0)"]

CMD ["sh", "-c", "python scripts/db_init.py && alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8848"]
